# Copie para .env (o run.sh faz isso e gera a senha). Sem valores versionados.
RABBITMQ_USER=
RABBITMQ_PASS=
POSTGRES_PASS=
# opcionais (ms-ingest): CORS_ORIGINS (padrão http://localhost:4200, o `ng serve`; `WITH_WEB=1 ./run.sh` acrescenta http://localhost:8080 ao .env), DEMO_TOKEN
# ms-api: API_DEMO_TOKEN (obrigatório; o run.sh gera) e API_CORS_ORIGINS (padrão http://localhost:4200, o `ng serve`; `WITH_WEB=1 ./run.sh` acrescenta http://localhost:8080 ao .env)
# opcionais (ms-worker): WORKER_CONCURRENCY e WORKER_PREFETCH (padrão 1 e 1; FIFO só com 1 e 1)
